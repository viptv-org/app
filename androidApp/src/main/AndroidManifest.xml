<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="VIPTV Experiment" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:banner="@drawable/tv_banner" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true">
        <!-- Icon and banner repeated on the launcher activity so launchers and aapt2 badging read them directly. -->
        <activity android:name="org.viptv.experiment.MainActivity" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:banner="@drawable/tv_banner" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
            <!-- The device sign-in QR (https://server/device?code=...): opens this app when installed, the website otherwise. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${viptvLinkHost}" android:path="/device" />
            </intent-filter>
        </activity>
        <!-- Shared torrent runtime (native transport v2): app-private worker process, never exported. -->
        <service android:name="org.viptv.experiment.TorrentRuntimeService" android:process=":torrent_runtime" android:exported="false" android:stopWithTask="true" />
    </application>
</manifest>
